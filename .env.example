# Provide your Gemini API key if using GenAI features
GEMINI_API_KEY=your_gemini_api_key_here

# Enable CPU_MODE for lightweight local development on CPU (mock XTTS, small models)
CPU_MODE=false

# Preserve temp files and detailed logs
DEBUG=true

# Object Storage Configuration (Cloudflare R2 / AWS S3)
# To use local file system fallback, leave S3_BUCKET_NAME empty.
S3_BUCKET_NAME=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
